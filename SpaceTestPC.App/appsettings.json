
{
  "testMode": "finished_product",
  "testModes": {
    "finished_product": {
      "displayName": "整机测试",
      "databaseName": "space-test-finished-product.db",
      "snLength": 20,
      "testParameters": {
        "battery_management": {
          "strategy": "board_sysfs",
          "chargerStatusPath": "/sys/class/power_supply/bq2579x-charger/status",
          "currentPath": "/sys/class/power_supply/cw221X-bat/current_now",
          "voltagePath": "/sys/class/power_supply/cw221X-bat/voltage_now",
          "requiredStatus": "Discharging",
          "voltageMinMv": 7000,
          "voltageMaxMv": 9000,
          "dischargeCurrentMinMa": 100,
          "dischargeCurrentMaxMa": 500,
          "samplingDurationMs": 4000,
          "sampleIntervalMs": 500,
          "minimumValidSamples": 6,
          "currentStabilityToleranceMa": 80,
          "operatorConfirmationTimeoutMs": 15000
        }
      }
    },
    "pcba": {
      "displayName": "PCBA 测试",
      "databaseName": "space-test-pcba.db",
      "snLength": 17,
      "enabledTests": [
        "board_state", "hdmi", "ethernet_led", "lcd",
        "typec_camera", "usb2", "usb3", "keys", "fan", "wifi",
        "bluetooth", "tf", "emmc", "ddr", "pcba_test_points", "pcba_indicator_led"
      ],
      // 放电电流由外部仪表（万用表/电子负载）人工判定，PCBA 上位机默认不自动采测，
      // 故默认禁用 battery_management；需要接入时把该 id 从这里删掉即可恢复。
      "disabledTests": [
        "battery_management",
        "typec_fast_charge",
        "indicator_led"
      ],
      "testParameters": {
        // 保留放电参数仅为后续重新启用该测试项时提供默认值。
        "battery_management": {
          "strategy": "board_sysfs",
          "chargerStatusPath": "/sys/class/power_supply/bq2579x-charger/status",
          "currentPath": "/sys/class/power_supply/cw221X-bat/current_now",
          "voltagePath": "/sys/class/power_supply/cw221X-bat/voltage_now",
          "requiredStatus": "Discharging",
          "voltageMinMv": 7000,
          "voltageMaxMv": 9000,
          "dischargeCurrentMinMa": 100,
          "dischargeCurrentMaxMa": 500,
          "samplingDurationMs": 4000,
          "sampleIntervalMs": 500,
          "minimumValidSamples": 6,
          "currentStabilityToleranceMa": 100,
          "operatorConfirmationTimeoutMs": 15000
        }
      }
    }
  },
