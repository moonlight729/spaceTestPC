{
  "jk5506": {
    "enabled": true,
    "portName": "COM5",
    "baudRate": 115200,
    "slaveAddress": 1,
    "timeoutMs": 1000
  },
  "jxTvm": {
    "enabled": true,
    "portName": "COM7"
  },
  "bluetoothBroadcaster": {
    "enabled": true,
    "portName": "COM6",
    "broadcastName": "yctc_bt_01"
  },
  "logging": {
    "fileEnabled": true,
    "filePath": "logs/space-test-pc.log"
  },
  "testPlan": {
    "allowSnMismatchForDebug": true,
    "enabledTests": [
      "board_state",
      "hdmi",
      "keys",
      "lcd",
      "ethernet",
      "wifi",
      "bluetooth",
      "fingerprint",
      "typec_camera",
      "tf",
      "usb2_3",
      "pcba_test_points",
      "indicator_led",
      "fan"
    ],
    "disabledTests": [],
    "skippedTests": {
      "indicator_led": "当前指示灯测试环境暂未接入",
      "fan": "当前风扇测试环境暂未接入",
      "fingerprint": "当前未接指纹模组",
      "usb2_3": "USB2.0&3.0 汇总文件接口暂未正式启用",
      "pcba_test_points": "PCBA测试点 32通道电压采集接口暂未正式启用"
    },
    "testParameters": {
      "wifi": {
        "ssid": "test_router_001",
        "interfaceName": "wlan0",
        "minRssi": -75,
        "maxRetryCount": 5,
        "retryIntervalMs": 2000,
        "decisionTimeoutMs": 5000,
        "scanTimeoutMs": 10000
      },
      "ethernet": {
        "interfaceName": "end0",
        "routerIp": "192.168.31.1",
        "pingCount": 4,
        "timeoutMs": 15000,
        "waitCableTimeoutMs": 30000,
        "progressReportIntervalMs": 1000,
        "waitCableUnplug": true,
        "unplugTimeoutMs": 10000
      },
      "bluetooth": {
        "mode": "observer",
        "targetName": "yctc_bt_01",
        "minRssi": -80,
        "scanWindowMs": 10000,
        "maxRetryCount": 5,
        "retryIntervalMs": 2000
      },
      "keys": {
        "timeoutMs": 45000
      },
      "fingerprint": {
        "bus": "spi",
        "command": "get_status",
        "timeoutMs": 3000
      },
      "typec_fast_charge": {
        "batterySimulationVoltageMv": 7400,
        "chargeVoltageMinMv": 7400,
        "chargeVoltageMaxMv": 8400,
        "chargeCurrentMinMa": 425,
        "chargeCurrentMaxMa": 650,
        "stableSampleCount": 3,
        "sampleIntervalMs": 500,
        "waitChargerTimeoutMs": 15000,
        "progressReportIntervalMs": 1000,
        "timeoutMs": 10000,
        "pmicBus": "i2c",
        "pmicCommand": "read_charge_status"
      },
      "typec_camera": {
        "streamProfile": "1080p30",
        "minInterruptCount": 200,
        "timeoutMs": 10000
      },
      "tf": {
        "command": "read_card_info",
        "mountTimeoutMs": 5000,
        "requireMounted": true
      },
      "usb2_3": {
        "recordFile": "/tmp/spacetest_usb_ports.json",
        "expectedUsb2Count": 2,
        "expectedUsb3Count": 2,
        "timeoutMs": 3000
      },
      "pcba_test_points": {
        "channelCount": 32,
        "recordFile": "/tmp/spacetest_pcba_points.json",
        "defaultMinMv": 0,
        "defaultMaxMv": 5000,
        "timeoutMs": 5000,
        "channels": []
      },
      "indicator_led": {
        "channel": 1,
        "highCommandExpectedVoltageMv": 0,
        "lowCommandExpectedVoltageMv": 3300,
        "toleranceMv": 150
      },
      "fan": {
        "channel": 2,
        "highCommandExpectedVoltageMv": 0,
        "lowCommandExpectedVoltageMv": 12000,
        "toleranceMv": 300
      },
      "battery_management": {
        "batterySimulationVoltageMv": 7400,
        "dischargeVoltageMinMv": 7000,
        "dischargeVoltageMaxMv": 7600,
        "dischargeCurrentMinMa": 100,
        "dischargeCurrentMaxMa": 500,
        "stableSampleCount": 3,
        "sampleIntervalMs": 500,
        "samplingDurationMs": 10000,
        "stabilityToleranceMa": 80,
        "waitReadyTimeoutMs": 120000,
        "progressReportIntervalMs": 1000,
        "timeoutMs": 30000
      }
    },
    "mock": {
      "failingTestId": null,
      "runningDelayMs": 2000,
      "resultHoldMs": 1000,
      "boardStateRunningDelayMs": 3000,
      "boardStateResultHoldMs": 5000
    },
    "continuous": {
      "enabledByDefault": false
    }
  }
