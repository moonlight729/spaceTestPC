<Window x:Class="SpaceTestPC.App.EnvironmentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测试设置"
        Width="760"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        Background="#EEF2F6">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="24" FontWeight="Bold" Text="测试设置" />
        <TextBlock Grid.Row="1" Margin="0,6,0,20" Foreground="#667085" Text="设备通信固定使用选定的物理网卡，保存后重启应用生效。" />

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="当前工作模式" />
            <ComboBox x:Name="ModeComboBox" Grid.Column="1" Height="34">
                <ComboBoxItem Tag="finished_product" Content="整机测试" />
                <ComboBoxItem Tag="pcba" Content="PCBA 测试" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="设备通信网卡" />
            <ComboBox x:Name="AdapterComboBox" Grid.Column="1" Height="34" Margin="0,0,8,0" DisplayMemberPath="DisplayText" SelectionChanged="AdapterComboBox_OnSelectionChanged" />
            <Button Grid.Column="2" Content="刷新网卡" Click="RefreshAdapters_Click" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="设备地址" />
            <TextBox x:Name="ConnectionHostTextBox" Grid.Column="1" Height="34" Margin="0,0,8,0" ToolTip="填写 auto 自动扫描选定网卡，或填写同网段固定 IP" />
            <Button x:Name="ProbeDeviceButton" Grid.Column="2" Content="探测设备" Click="ProbeDevice_Click" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="设备端口" />
            <TextBox x:Name="ConnectionPortTextBox" Grid.Column="1" Height="34" />
        </Grid>

        <Grid Grid.Row="6" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="蓝牙串口" />
            <ComboBox x:Name="PortComboBox" Grid.Column="1" Height="34" IsEditable="True" />
        </Grid>

        <Grid Grid.Row="7" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="蓝牙目标名称" />
            <TextBox x:Name="TargetNameTextBox" Grid.Column="1" Height="34" />
        </Grid>

        <Grid Grid.Row="8" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Wi-Fi SSID" />
            <TextBox x:Name="WifiSsidTextBox" Grid.Column="1" Height="34" />
        </Grid>

        <Grid Grid.Row="9" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="固件路径" />
            <TextBox x:Name="FirmwarePathTextBox" Grid.Column="1" Height="34" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="选择文件" Click="BrowseFirmwarePath_Click" />
        </Grid>

        <Border Grid.Row="10" Padding="14" Background="#F8FAFC" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="SummaryTextBlock" Foreground="#667085" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="90" Margin="0,0,10,0" Content="取消" Click="Cancel_Click" />
            <Button Width="120" Background="#175CD3" Foreground="White" Content="保存并应用" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
