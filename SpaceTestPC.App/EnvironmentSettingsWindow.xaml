<Window x:Class="SpaceTestPC.App.EnvironmentSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="测试设置" Width="720" Height="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Microsoft YaHei UI" Background="#EEF2F6">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="测试设置" FontSize="24" FontWeight="Bold"/><TextBlock Grid.Row="1" Margin="0,6,0,20" Foreground="#667085" Text="显示当前配置并允许修改。工作模式及测试计划需重启应用后完全生效。"/>
        <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="当前工作模式" VerticalAlignment="Center"/><ComboBox x:Name="ModeComboBox" Grid.Column="1" Height="34"><ComboBoxItem Tag="finished_product" Content="整机测试"/><ComboBoxItem Tag="pcba" Content="PCBA 测试"/></ComboBox></Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="蓝牙串口" VerticalAlignment="Center"/><ComboBox x:Name="PortComboBox" Grid.Column="1" Height="34" IsEditable="True"/></Grid>
        <Grid Grid.Row="4" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="蓝牙目标名称" VerticalAlignment="Center"/><TextBox x:Name="TargetNameTextBox" Grid.Column="1" Height="34"/></Grid>
        <Grid Grid.Row="5" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Wi-Fi SSID" VerticalAlignment="Center"/><TextBox x:Name="WifiSsidTextBox" Grid.Column="1" Height="34"/></Grid>
        <Grid Grid.Row="6" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="固件路径" VerticalAlignment="Center"/><TextBox x:Name="FirmwarePathTextBox" Grid.Column="1" Height="34" Margin="0,0,8,0"/><Button Grid.Column="2" Content="选择文件" Click="BrowseFirmwarePath_Click"/></Grid>
        <Border Grid.Row="7" Padding="14" Background="#F8FAFC" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="6"><TextBlock x:Name="SummaryTextBlock" Foreground="#667085" TextWrapping="Wrap"/></Border>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="取消" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="保存并应用" Width="120" Background="#175CD3" Foreground="White" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
