<Window x:Class="SpaceTestPC.App.EnvironmentSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="环境配置" Width="620" Height="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Microsoft YaHei UI">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="环境配置" FontSize="24" FontWeight="Bold" Margin="0,0,0,24"/>
    <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="蓝牙串口" VerticalAlignment="Center"/><ComboBox x:Name="PortComboBox" Grid.Column="1" Height="32"/></Grid>
    <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="蓝牙目标名称" VerticalAlignment="Center"/><TextBox x:Name="TargetNameTextBox" Grid.Column="1" Height="32"/></Grid>
    <Grid Grid.Row="3" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Wi-Fi SSID" VerticalAlignment="Center"/><TextBox x:Name="WifiSsidTextBox" Grid.Column="1" Height="32"/></Grid>
    <Grid Grid.Row="4" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="默认固件路径" VerticalAlignment="Center"/><TextBox x:Name="FirmwarePathTextBox" Grid.Column="1" Height="32" Margin="0,0,8,0"/><Button Grid.Column="2" Content="选择目录" Click="BrowseFirmwarePath_Click"/></Grid>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="保存" Width="90" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
