{
  "testPlan": {
    // enabledTests 非空时，只运行这里列出的测试项；执行顺序仍按程序内固定顺序。
    // 示例: "enabledTests": ["board_state", "wifi"]
    "enabledTests": [],

    // enabledTests 为空时，运行完整测试计划，再排除这里列出的测试项。
    "disabledTests": [],

    // skippedTests 表示本轮不测试，不计入最终 PASS/FAIL。
    "skippedTests": {
      "indicator_led": "当前指示灯测试环境暂未接入",
      "fan": "当前风扇测试环境暂未接入",
      "fingerprint": "当前未接指纹模组",
      "usb2_3": "USB2.0&3.0 汇总文件接口暂未正式启用",
      "pcba_test_points": "PCBA测试点 32通道电压采集接口暂未正式启用"
    },

    // 每个测试项下发给 3576 的参数。
    "testParameters": {
      "wifi": {
        "ssid": "test_router_001",
        "password": "test_router_001",
        "routerIp": "192.168.1.1",
        "pingCount": 4,
        "timeoutMs": 15000
      },
      "ethernet": {
        "interfaceName": "end0",
        "routerIp": "192.168.110.1",
        "pingCount": 4,
        "timeoutMs": 15000,
        "waitCableUnplug": true,
        "unplugTimeoutMs": 10000
      },
      "bluetooth": {
        "mode": "observer",
        "targetName": "NODE_A_01",
        "minRssi": -80,
        "scanWindowMs": 10000
      },
      "keys": {
        "timeoutMs": 30000
      },
      "fingerprint": {
        "bus": "spi",
        "command": "get_status",
        "timeoutMs": 3000
      },
      "typec_fast_charge": {
        "batterySimulationVoltageMv": 7400,
        "chargeVoltageMinMv": 7400,
        "chargeVoltageMaxMv": 8400,
        "chargeCurrentMinMa": 500,
        "chargeCurrentMaxMa": 3000,
        "stableSampleCount": 3,
        "sampleIntervalMs": 500,
        "timeoutMs": 20000,
        "pmicBus": "i2c",
        "pmicCommand": "read_charge_status"
      },
      "typec_camera": {
        "streamProfile": "1080p30",
        "minInterruptCount": 200,
        "timeoutMs": 10000
      },
      "tf": {
        "command": "read_card_info",
        "mountTimeoutMs": 5000,
        "requireMounted": true
      },
      "usb2_3": {
        "recordFile": "/tmp/spacetest_usb_ports.json",
        "expectedUsb2Count": 2,
        "expectedUsb3Count": 2,
        "timeoutMs": 3000
      },
      "pcba_test_points": {
        "channelCount": 32,
        "recordFile": "/tmp/spacetest_pcba_points.json",
        "defaultMinMv": 0,
        "defaultMaxMv": 5000,
        "timeoutMs": 5000,
        "channels": []
      }
    },

    "mock": {
      // 指定某一项 Mock 失败；null 表示不注入失败。
      "failingTestId": null,
      "runningDelayMs": 2000,
      "resultHoldMs": 1000,
      "boardStateRunningDelayMs": 3000,
      "boardStateResultHoldMs": 5000
    }
  }
}
