{
  "bluetoothBroadcaster": {
    // Upper-PC BLE broadcaster. 3576 scans for this same name.
    "enabled": true,
    "portName": "COM6",
    "broadcastName": "yctc_bt_01"
  },
  "logging": {
    // Relative paths are resolved under the application output directory.
    "fileEnabled": true,
    "filePath": "logs/space-test-pc.log"
  },
  "testPlan": {
    // Debug only. true allows testing to continue when board SN differs from scanned SN.
    // Production must keep this false to prevent testing the wrong board.
    "allowSnMismatchForDebug": false,

    // If enabledTests is not empty, only these tests run. Execution still follows the built-in order.
    "enabledTests": [],

    // If enabledTests is empty, the full test plan runs except items listed here.
    "disabledTests": [],

    // skippedTests means "not tested in this run"; it is recorded but not counted as final failure.
    "skippedTests": {
      "indicator_led": "当前指示灯测试环境暂未接入",
      "fan": "当前风扇测试环境暂未接入",
      "fingerprint": "当前未接指纹模组",
      "usb2_3": "USB2.0&3.0 汇总文件接口暂未正式启用",
      "pcba_test_points": "PCBA测试点 32通道电压采集接口暂未正式启用"
    },

    "testParameters": {
      "wifi": {
        "ssid": "test_router_001",
        "password": "test_router_001",
        "routerIp": "192.168.1.1",
        "pingCount": 4,
        "timeoutMs": 15000
      },
      "ethernet": {
        "interfaceName": "end0",
        "routerIp": "192.168.110.1",
        "pingCount": 4,
        "timeoutMs": 15000,
        "waitCableUnplug": true,
        "unplugTimeoutMs": 10000
      },
      "bluetooth": {
        "mode": "observer",
        // This value is overridden by bluetoothBroadcaster.broadcastName in the real test plan.
        "targetName": "yctc_bt_01",
        "minRssi": -80,
        "scanWindowMs": 10000
      },
      "keys": {
        "timeoutMs": 45000
      },
      "fingerprint": {
        "bus": "spi",
        "command": "get_status",
        "timeoutMs": 3000
      },
      "typec_fast_charge": {
        "batterySimulationVoltageMv": 7400,
        "chargeVoltageMinMv": 7400,
        "chargeVoltageMaxMv": 8400,
        "chargeCurrentMinMa": 500,
        "chargeCurrentMaxMa": 3000,
        "stableSampleCount": 3,
        "sampleIntervalMs": 500,
        "timeoutMs": 20000
      },
      "typec_camera": {
        "streamProfile": "1080p30",
        "minInterruptCount": 200,
        "timeoutMs": 10000
      },
      "tf": {
        "devicePath": "/dev/mmcblk1p1",
        "mountPoint": "/mnt/spacetest_tf",
        "allowFormatExt4": true,
        "minCapacityMb": 1,
        "mountTimeoutMs": 5000
      },
      "usb2_3": {
        "recordFile": "/tmp/spacetest_usb_ports.json",
        "expectedUsb2Count": 2,
        "expectedUsb3Count": 2,
        "timeoutMs": 3000
      },
      "pcba_test_points": {
        "channelCount": 32,
        "recordFile": "/tmp/spacetest_pcba_points.json",
        "defaultMinMv": 0,
        "defaultMaxMv": 5000,
        "timeoutMs": 5000,
        "channels": []
      }
    },

    "mock": {
      "failingTestId": null,
      "runningDelayMs": 2000,
      "resultHoldMs": 1000,
      "boardStateRunningDelayMs": 3000,
      "boardStateResultHoldMs": 5000
    }
  }
}
