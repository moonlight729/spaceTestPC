<Window x:Class="SpaceTestPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="{DynamicResource WindowIcon}"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        WindowState="Maximized"
        Background="#EEF2F6"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DrawingImage x:Key="WindowIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#175CD3" Geometry="M 4,4 L 28,4 L 28,28 L 4,28 Z" />
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M 9,9 L 23,9 L 23,23 L 9,23 Z" />
                    <GeometryDrawing Brush="#175CD3" Geometry="M 12,12 L 20,12 L 20,20 L 12,20 Z" />
                    <GeometryDrawing Brush="#175CD3" Geometry="M 1,8 L 4,8 L 4,10 L 1,10 Z M 1,15 L 4,15 L 4,17 L 1,17 Z M 28,8 L 31,8 L 31,10 L 28,10 Z M 28,15 L 31,15 L 31,17 L 28,17 Z M 8,1 L 10,1 L 10,4 L 8,4 Z M 15,1 L 17,1 L 17,4 L 15,4 Z M 8,28 L 10,28 L 10,31 L 8,31 Z M 15,28 L 17,28 L 17,31 L 15,31 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1D2939" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#1463D7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E0EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#101828" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1F3A" CornerRadius="8" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Width="260" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border MinWidth="148" Padding="18,8" Background="{Binding TestModeBannerBackground}" CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White" Text="{Binding TestModeBannerText}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="White" Text="Space 测试工作台" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="82" Height="34" Margin="0,0,10,0" Padding="0" HorizontalContentAlignment="Center" Background="#0B1F3A" Foreground="#FFFFFF" BorderBrush="#175CD3" BorderThickness="1" Focusable="False" IsTabStop="False" Click="EnvironmentSettings_Click" Content="设置" />
                    <Button Width="142" Height="34" Margin="0,0,22,0" Padding="0" HorizontalContentAlignment="Center" Background="#344054" Command="{Binding ShowQueryPageCommand}" Content="QUERY RECORDS" />
                    <StackPanel Width="100" Margin="0,0,18,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" Foreground="#B8C7D9" Text="BOARD" />
                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White" Text="{Binding BoardId}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Width="112" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#B8C7D9" Text="MODE" />
                        <Border Margin="0,4,0,0" Padding="10,4" Background="{Binding OperationModeBackground}" CornerRadius="12" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="White" Text="{Binding OperationModeDisplayName}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14" Visibility="{Binding IsTestPage, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,14,0">
                <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="SCAN SN" />
                        <TextBlock Margin="0,4,0,0" Foreground="#667085" FontSize="12" Text="Scan to start a new test" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="ScannerInputTextBox"
                                 Height="42"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F8FAFC"
                                 BorderBrush="#98A2B3"
                                 FontSize="16"
                                 KeyDown="ScannerInputTextBox_OnKeyDown"
                                 TextChanged="ScannerInputTextBox_OnTextChanged"
                                 Text="{Binding ScannerInput, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Grid.Column="2" Width="116" Height="42" Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding ScanCommand}" Content="Scan / Query" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Height="150" VerticalAlignment="Top" Style="{StaticResource Card}" Padding="14,10" Background="#F8FAFC" BorderBrush="#D8E0EA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Foreground="#667085" FontSize="12" HorizontalAlignment="Center" Text="FINAL RESULT" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{Binding FinalVerdictForeground}"
                                   Text="{Binding FinalVerdictDisplay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Margin="10,0,0,0" Height="28" Padding="10,0" Background="#175CD3" Command="{Binding StartPhaseOneCommand}" Content="Re-test" Visibility="{Binding IsHistoryLoaded, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Visibility="{Binding IsTestPage, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,14,18,10" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="TEST SEQUENCE" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#667085" Text="{Binding TestOverviewColumns, StringFormat={}{0} items}" />
                    </Grid>
                    <Border Grid.Row="1" Margin="12,0,12,8" Padding="10" Background="#F8FAFC" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Grid>
                                <TextBlock FontWeight="SemiBold" Text="测试点选择" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Height="26" Padding="10,0" Command="{Binding SelectAllTestsCommand}" Content="全选" />
                                    <Button Height="26" Margin="8,0,0,0" Padding="10,0" Command="{Binding DeselectAllTestsCommand}" Content="全不选" />
                                    <Button Height="26" Margin="8,0,0,0" Padding="10,0" Background="#175CD3" Foreground="White" Command="{Binding SelectWifiOnlyCommand}" Content="仅 Wi-Fi" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,7,0,5" Foreground="#475467" Text="{Binding TestSelectionSummary}" TextTrimming="CharacterEllipsis" />
                            <Expander Header="展开自定义选择">
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TestSelections}" IsEnabled="{Binding IsTestSelectionEnabled}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Width="116" Margin="0,5,4,2" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="2"
                             x:Name="TestSequenceListBox"
                             Margin="8,0,3,8"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TestSequenceListBox_OnSelectionChanged"
                             ItemsSource="{Binding TestItems}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,4,1,4"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="{Binding BackgroundBrush}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding AccentBrush}" CornerRadius="5,0,0,5" />
                                        <Ellipse Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                                        <StackPanel Grid.Column="2" Margin="0,11">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#667085" Text="{Binding StateLabel}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding StateBrush}" TextAlignment="Center" Text="{Binding StateLabel}" />
                                        <Button Grid.Column="4"
                                                Width="76"
                                                Height="30"
                                                Margin="0,0,5,0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Background="#FFFFFF"
                                                BorderBrush="#F04438"
                                                Foreground="#B42318"
                                                BorderThickness="1"
                                                Command="{Binding DataContext.RetestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding TestId}"
                                                Content="{Binding RetestButtonText}"
                                                Visibility="{Binding CanRetest, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.RowSpan="3" Height="4" VerticalAlignment="Bottom" Background="#DCEBFA" CornerRadius="0,0,7,7" Panel.ZIndex="2" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Foreground="#667085" FontSize="12" Text="CURRENT TEST" />
                            <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding SelectedTestResult.DisplayName}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Height="34"
                                    Margin="0,0,10,0"
                                    Padding="14,0"
                                    Background="#B42318"
                                    BorderBrush="#B42318"
                                    Foreground="White"
                                    Command="{Binding EndFailedBoardCommand}"
                                    Content="结束本机测试"
                                    Visibility="{Binding IsRetestLifecycleActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Border Padding="14,7" Background="#F2F4F7" CornerRadius="16">
                                <TextBlock FontWeight="Bold" Foreground="{Binding SelectedTestResult.StateBrush}" Text="{Binding SelectedTestResult.StateLabel}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,24,0,0" Padding="18" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="6">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#175CD3" TextWrapping="Wrap" Text="{Binding OperatorInstruction}" />
                    </Border>
                    <ScrollViewer Grid.Row="2" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="RESULT DETAIL" />
                            <ItemsControl Margin="0,12,0,4" ItemsSource="{Binding DirectionalKeys}" Visibility="{Binding IsKeyTestDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding DataContext.KeyGridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,10,0" Padding="12" Background="{Binding Background}" CornerRadius="6"><StackPanel><TextBlock HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Text="{Binding Label}" /><TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="White" Text="{Binding StatusText}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Margin="0,12,0,8" ItemsSource="{Binding SelectedUsbTestSteps}" Visibility="{Binding IsUsbTestDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,12,0" Padding="14" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="2" CornerRadius="8">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground}" Text="{Binding StepLabel}" />
                                                    <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{Binding Foreground}" Text="{Binding StatusText}" />
                                                </Grid>
                                                <Grid Height="68" Margin="0,12,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="48" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{Binding Foreground}" BorderThickness="3" CornerRadius="3">
                                                        <Border Width="28" Height="5" Background="{Binding Foreground}" CornerRadius="2" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="{Binding Foreground}" Text="{Binding ActionSymbol}" />
                                                    <Grid Grid.Column="2" Width="48" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Width="30" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Foreground}" CornerRadius="3,0,0,3" />
                                                        <Border Width="18" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="{Binding Foreground}" BorderThickness="3" CornerRadius="0,2,2,0" />
                                                    </Grid>
                                                </Grid>
                                                <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{Binding Foreground}" Text="{Binding PortLabel}" />
                                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{Binding Foreground}" Text="{Binding DetailText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Margin="0,12,0,8" ItemsSource="{Binding PcbaTestPoints}" Visibility="{Binding IsPcbaTestPointsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10" Padding="10" Background="{Binding Background}" CornerRadius="7">
                                            <StackPanel>
                                                <Grid><TextBlock FontWeight="Bold" Foreground="{Binding Foreground}" Text="{Binding Name}"/><TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="{Binding Foreground}" Text="{Binding StatusDisplay}"/></Grid>
                                                <TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Foreground}" Text="{Binding ValueDisplay}"/>
                                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{Binding Foreground}" Text="{Binding RangeDisplay}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,12,0,0" FontSize="16" TextWrapping="Wrap" Text="{Binding SelectedTestResult.Message}" />
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="#667085" Text="Result code" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SelectedTestResult.ResultCode}" />
                                <TextBlock Grid.Row="1" Margin="0,12,0,0" Foreground="#667085" Text="Duration" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding SelectedTestResult.Duration}" />
                            </Grid>
                            <TextBlock Margin="0,28,0,8" Style="{StaticResource SectionTitle}" Text="MEASUREMENT / DEVICE DATA" />
                            <TextBox MinHeight="150" Padding="14" Background="#101828" BorderThickness="0" Foreground="#D0D5DD" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding SelectedTestResult.DataText, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Margin="0,22,0,0" Padding="16" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsManualDecisionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#9A3412" TextWrapping="Wrap" Text="{Binding ManualDecisionPrompt}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="116" Margin="0,0,10,0" Command="{Binding ConfirmManualPassCommand}" Content="PASS" />
                                <Button Width="116" Background="#B42318" Command="{Binding ConfirmManualFailCommand}" Content="FAIL" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Margin="0,22,0,0" Padding="16" Background="#EFF8FF" BorderBrush="#84CAFF" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsUpgradePromptVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#175CD3" TextWrapping="Wrap" Text="{Binding UpgradePromptText}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="116" Margin="0,0,10,0" Command="{Binding UpgradeNowCommand}" Content="立即升级" />
                                <Button Width="116" Background="#667085" Command="{Binding SkipUpgradeCommand}" Content="暂不升级" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.RowSpan="4" Height="4" VerticalAlignment="Bottom" Background="#DCEBFA" CornerRadius="0,0,7,7" Panel.ZIndex="2" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.RowSpan="2" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="28" Visibility="{Binding IsQueryPage, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="TEST RECORD QUERY" />
                    <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="Recent tests are loaded automatically. Enter an SN or board ID only when you need to filter the list." />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,24,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBox Height="42" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#98A2B3" FontSize="16" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding QueryRecordsCommand}" Content="Search" />
                    <TextBlock Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="Showing up to 200 most recent sessions" />
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding QuerySessions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="42" AlternatingRowBackground="#F8FAFC" BorderBrush="#D8E0EA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SN" Binding="{Binding Session.Sn}" Width="2*" />
                        <DataGridTextColumn Header="RESULT" Binding="{Binding Session.FinalVerdict}" Width="*" />
                        <DataGridTextColumn Header="BOARD ID" Binding="{Binding BoardState.BoardId}" Width="*" />
                        <DataGridTextColumn Header="START TIME" Binding="{Binding Session.StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="2*" />
                        <DataGridTextColumn Header="END TIME" Binding="{Binding Session.EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="2*" />
                        <DataGridTextColumn Header="ITEMS" Binding="{Binding TestResults.Count}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="14,0" Background="#F8FAFC" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#475467" FontWeight="SemiBold" Text="{Binding StatusBarRunState}" />
                    <TextBlock Margin="14,0" Foreground="#CBD5E1" Text="|" />
                    <TextBlock Foreground="#667085" Text="{Binding StatusBarProgress}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Foreground="#667085" Text="{Binding StatusBarSn}" />
                    <TextBlock Margin="14,0" Foreground="#CBD5E1" Text="|" />
                    <TextBlock Foreground="#667085" Text="{Binding StatusBarElapsedTime}" />
                    <TextBlock Margin="14,0" Foreground="#CBD5E1" Text="|" />
                    <TextBlock Foreground="#175CD3" FontWeight="SemiBold" Text="{Binding StatusBarConnection}" />
                    <TextBlock Margin="14,0" Foreground="#CBD5E1" Text="|" />
                    <TextBlock Foreground="#667085" Text="{Binding StatusBarJxTvm}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#15803D" Text="{Binding StatusBarDatabase}" />
                    <TextBlock Margin="12,0" Foreground="#CBD5E1" Text="|" />
                    <TextBlock Foreground="#15803D" Text="{Binding StatusBarLog}" />
                    <TextBlock Margin="12,0" Foreground="#CBD5E1" Text="|" />
                    <TextBlock Foreground="#667085" Text="{Binding StatusBarCurrentTime}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,22" Background="#FFF1F2" BorderBrush="#DC2626" BorderThickness="3" CornerRadius="8" Visibility="{Binding IsTfRemovalPromptVisible, Converter={StaticResource BoolToVisibilityConverter}}">
