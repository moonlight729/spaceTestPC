<Window x:Class="SpaceTestPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="{DynamicResource WindowIcon}"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        Background="#EEF2F6"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DrawingImage x:Key="WindowIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#175CD3" Geometry="M 4,4 L 28,4 L 28,28 L 4,28 Z" />
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M 9,9 L 23,9 L 23,23 L 9,23 Z" />
                    <GeometryDrawing Brush="#175CD3" Geometry="M 12,12 L 20,12 L 20,20 L 12,20 Z" />
                    <GeometryDrawing Brush="#175CD3" Geometry="M 1,8 L 4,8 L 4,10 L 1,10 Z M 1,15 L 4,15 L 4,17 L 1,17 Z M 28,8 L 31,8 L 31,10 L 28,10 Z M 28,15 L 31,15 L 31,17 L 28,17 Z M 8,1 L 10,1 L 10,4 L 8,4 Z M 15,1 L 17,1 L 17,4 L 15,4 Z M 8,28 L 10,28 L 10,31 L 8,31 Z M 15,28 L 17,28 L 17,31 L 15,31 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1D2939" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#1463D7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E0EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#101828" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1F3A" CornerRadius="8" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Width="168" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border MinWidth="148" Padding="18,8" Background="{Binding TestModeBannerBackground}" CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White" Text="{Binding TestModeBannerText}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="White" Text="Space 测试工作台" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="82" Height="34" Margin="0,0,10,0" Padding="0" HorizontalContentAlignment="Center" Background="#175CD3" Command="{Binding ShowTestPageCommand}" Content="TEST" />
                    <Button Width="142" Height="34" Margin="0,0,22,0" Padding="0" HorizontalContentAlignment="Center" Background="#344054" Command="{Binding ShowQueryPageCommand}" Content="QUERY RECORDS" />
                    <StackPanel Width="100" Margin="0,0,18,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" Foreground="#B8C7D9" Text="BOARD" />
                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White" Text="{Binding BoardId}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,18,0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" Foreground="#B8C7D9" Text="CONNECTION" />
                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White" Text="{Binding BoardState}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Width="112" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#B8C7D9" Text="MODE" />
                        <Border Margin="0,4,0,0" Padding="10,4" Background="{Binding SnPolicyModeBackground}" CornerRadius="12" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{Binding SnPolicyModeForeground}" Text="{Binding SnPolicyModeName}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14" Visibility="{Binding IsTestPage, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,14,0">
                <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="SCAN SN" />
                        <TextBlock Margin="0,4,0,0" Foreground="#667085" FontSize="12" Text="Scan to start a new test" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="ScannerInputTextBox"
                                 Height="42"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F8FAFC"
                                 BorderBrush="#98A2B3"
                                 FontSize="16"
                                 KeyDown="ScannerInputTextBox_OnKeyDown"
                                 TextChanged="ScannerInputTextBox_OnTextChanged"
                                 Text="{Binding ScannerInput, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Grid.Column="2" Width="116" Height="42" Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding ScanCommand}" Content="Scan / Query" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Height="150" VerticalAlignment="Top" Style="{StaticResource Card}" Padding="14,10" Background="#F8FAFC" BorderBrush="#D8E0EA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Foreground="#667085" FontSize="12" HorizontalAlignment="Center" Text="FINAL RESULT" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{Binding FinalVerdictForeground}"
                                   Text="{Binding FinalVerdictDisplay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Margin="10,0,0,0" Height="28" Padding="10,0" Background="#175CD3" Command="{Binding StartPhaseOneCommand}" Content="Re-test" Visibility="{Binding IsHistoryLoaded, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Visibility="{Binding IsTestPage, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="TEST SEQUENCE" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#667085" Text="{Binding TestOverviewColumns, StringFormat={}{0} items}" />
                    </Grid>
                    <ListBox Grid.Row="1"
                             x:Name="TestSequenceListBox"
                             Margin="8,0,8,8"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="False"
                             SelectionChanged="TestSequenceListBox_OnSelectionChanged"
                             ItemsSource="{Binding TestItems}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4"
                                        Padding="14,11"
                                        Cursor="Hand"
                                        Background="#F8FAFC"
                                        BorderBrush="#E4E7EC"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#667085" Text="{Binding StateLabel}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding StateBrush}" Text="{Binding StateLabel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Foreground="#667085" FontSize="12" Text="CURRENT TEST" />
                            <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding SelectedTestResult.DisplayName}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" Background="#F2F4F7" CornerRadius="16">
                            <TextBlock FontWeight="Bold" Foreground="{Binding SelectedTestResult.StateBrush}" Text="{Binding SelectedTestResult.StateLabel}" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,24,0,0" Padding="18" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="6">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#175CD3" TextWrapping="Wrap" Text="{Binding OperatorInstruction}" />
                    </Border>
                    <ScrollViewer Grid.Row="2" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="RESULT DETAIL" />
                            <TextBlock Margin="0,12,0,0" FontSize="16" TextWrapping="Wrap" Text="{Binding SelectedTestResult.Message}" />
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="#667085" Text="Result code" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SelectedTestResult.ResultCode}" />
                                <TextBlock Grid.Row="1" Margin="0,12,0,0" Foreground="#667085" Text="Duration" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding SelectedTestResult.Duration}" />
                            </Grid>
                            <TextBlock Margin="0,28,0,8" Style="{StaticResource SectionTitle}" Text="MEASUREMENT / DEVICE DATA" />
                            <TextBox MinHeight="150" Padding="14" Background="#101828" BorderThickness="0" Foreground="#D0D5DD" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding SelectedTestResult.DataText, Mode=OneWay}" />
                            <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding DirectionalKeys}" Visibility="{Binding IsKeyTestDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,10,0" Padding="12" Background="{Binding Background}" CornerRadius="6"><StackPanel><TextBlock HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" Text="{Binding Label}" /><TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="White" Text="{Binding StatusText}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Margin="0,22,0,0" Padding="16" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsManualDecisionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#9A3412" TextWrapping="Wrap" Text="{Binding ManualDecisionPrompt}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="116" Margin="0,0,10,0" Command="{Binding ConfirmManualPassCommand}" Content="PASS" />
                                <Button Width="116" Background="#B42318" Command="{Binding ConfirmManualFailCommand}" Content="FAIL" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Margin="0,22,0,0" Padding="16" Background="#EFF8FF" BorderBrush="#84CAFF" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsUpgradePromptVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#175CD3" TextWrapping="Wrap" Text="{Binding UpgradePromptText}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="116" Margin="0,0,10,0" Command="{Binding UpgradeNowCommand}" Content="立即升级" />
                                <Button Width="116" Background="#667085" Command="{Binding SkipUpgradeCommand}" Content="暂不升级" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="16" Visibility="{Binding IsTestPage, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="RUN LOG" />
                    <TextBlock Margin="0,4,0,0" Foreground="#667085" FontSize="12" Text="Latest events" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         Margin="10,0"
                         Padding="10"
                         Background="#F8FAFC"
                         BorderBrush="#E4E7EC"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="#475467"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding LogsText, Mode=OneWay}" />
                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding StartMockSessionCommand}"
                        Content="Run Mock"
                        Visibility="{Binding IsMockVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="3" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="28" Visibility="{Binding IsQueryPage, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="TEST RECORD QUERY" />
                    <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="Recent tests are loaded automatically. Enter an SN or board ID only when you need to filter the list." />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,24,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBox Height="42" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#98A2B3" FontSize="16" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding QueryRecordsCommand}" Content="Search" />
                    <TextBlock Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="Showing up to 200 most recent sessions" />
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding QuerySessions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="42" AlternatingRowBackground="#F8FAFC" BorderBrush="#D8E0EA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SN" Binding="{Binding Session.Sn}" Width="2*" />
                        <DataGridTextColumn Header="RESULT" Binding="{Binding Session.FinalVerdict}" Width="*" />
                        <DataGridTextColumn Header="BOARD ID" Binding="{Binding BoardState.BoardId}" Width="*" />
                        <DataGridTextColumn Header="START TIME" Binding="{Binding Session.StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="2*" />
                        <DataGridTextColumn Header="END TIME" Binding="{Binding Session.EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="2*" />
                        <DataGridTextColumn Header="ITEMS" Binding="{Binding TestResults.Count}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
