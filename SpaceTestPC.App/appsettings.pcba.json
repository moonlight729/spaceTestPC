{
  "testMode": "pcba",
  "testModes": {
    "pcba": {
      "displayName": "PCBA Test",
      "databaseName": "space-test-pcba.db",
      "snLength": 17,
      "enabledTests": [
        "board_state", "hdmi", "ethernet_led", "lcd",
        "typec_camera", "usb2", "usb3", "keys", "fan", "wifi",
        "bluetooth", "tf", "emmc", "ddr", "pcba_test_points", "pcba_indicator_led"
      ],
      // Discharge current is judged with an external meter, so PCBA keeps
      // battery_management disabled by default.
      "disabledTests": [
        "battery_management",
        "typec_fast_charge",
        "indicator_led"
      ],
      "skippedTests": {
      },
      "testOrder": [
        "board_state",
        "pcba_test_points",
        "pcba_indicator_led",
        "hdmi",
        "ethernet_led",
        "lcd",
        "typec_camera",
        "usb2",
        "usb3",
        "keys",
        "fan",
        "wifi",
        "bluetooth",
        "tf",
        "emmc",
        "ddr",
      ],
      "testParameters": {
        "wifi": {
          "minRssi": -40
        },
        "bluetooth": {
          "minRssi": -60
        },
        "pcba_indicator_led": {
          "phaseDurationMs": 2000,
          "cycleCount": 2,
          "manualDecisionTimeoutMs": 30000
        },
        "keys": {
          "maskromAdcPath": "/sys/devices/platform/2ae00000.adc/iio:device0/in_voltage0_raw",
          "maskromPressThreshold": 100,
          "maskromMaxRaw": 5000,
          "maskromStableSampleCount": 3,
          "maskromSampleIntervalMs": 100,
          "maskromTimeoutMs": 10000,
          "recoveryAdcPath": "/sys/devices/platform/2ae00000.adc/iio:device0/in_voltage1_raw",
          "recoveryPressThreshold": 100,
          "recoveryMaxRaw": 5000,
          "recoveryStableSampleCount": 3,
          "recoverySampleIntervalMs": 100,
          "recoveryTimeoutMs": 10000
        }
      }
    }
  }
}
