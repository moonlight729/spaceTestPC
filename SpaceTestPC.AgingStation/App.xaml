<Application x:Class="SpaceTestPC.AgingStation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="IdleBrush" Color="#9E9E9E" />
        <SolidColorBrush x:Key="PreparingBrush" Color="#FF9800" />
        <SolidColorBrush x:Key="RunningBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="CleaningBrush" Color="#9C27B0" />
        <SolidColorBrush x:Key="WaitingBrush" Color="#FFC107" />
        <SolidColorBrush x:Key="PassedBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="FailedBrush" Color="#F44336" />

        <!-- 槽位卡片：边框颜色直接由设备状态驱动，一眼扫出异常槽位。 -->
        <Style x:Key="SlotCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource IdleBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Width" Value="196" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="PREPARING">
                    <Setter Property="BorderBrush" Value="{StaticResource PreparingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="RUNNING">
                    <Setter Property="BorderBrush" Value="{StaticResource RunningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="CLEANING">
                    <Setter Property="BorderBrush" Value="{StaticResource CleaningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="WAITING_MANUAL_CHECK">
                    <Setter Property="BorderBrush" Value="{StaticResource WaitingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="PASSED">
                    <Setter Property="BorderBrush" Value="{StaticResource PassedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="FAILED">
                    <Setter Property="BorderBrush" Value="{StaticResource FailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
