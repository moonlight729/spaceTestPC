<Window x:Class="SpaceTestPC.AgingStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="老化测试工作站"
        Height="820" Width="1320"
        Background="#F5F5F5">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与全局信息 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="老化测试工作站" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DurationText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#555" />
            <TextBlock Text="{Binding SummaryText}" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#0066CC" />
        </DockPanel>

        <!-- 操作条 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="全部开始" Padding="12,6" Margin="0,0,6,0" Command="{Binding StartAllCommand}" />
            <Button Content="开始选中" Padding="12,6" Margin="0,0,6,0" Command="{Binding StartSelectedCommand}" />
            <Button Content="停止选中" Padding="12,6" Margin="0,0,6,0" Command="{Binding StopSelectedCommand}" />
            <Button Content="全部停止" Padding="12,6" Margin="0,0,6,0" Command="{Binding StopAllCommand}" />
            <Separator Width="12" Visibility="Hidden" />
            <Button Content="全选" Padding="10,6" Margin="0,0,6,0" Command="{Binding SelectAllCommand}" />
            <Button Content="清空选择" Padding="10,6" Margin="0,0,6,0" Command="{Binding ClearSelectionCommand}" />
            <Separator Width="12" Visibility="Hidden" />
            <Button Content="立即刷新" Padding="10,6" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
            <Button Content="{Binding MonitoringButtonText}" Padding="10,6" Margin="0,0,6,0" Command="{Binding ToggleMonitoringCommand}" />
            <Button Content="导出报告" Padding="10,6" Command="{Binding ExportReportCommand}" />
        </WrapPanel>

        <!-- 槽位网格 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SlotCardStyle}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StateText}" DockPanel.Dock="Right" FontSize="11"
                                               VerticalAlignment="Center" Foreground="#444" />
                                </DockPanel>

                                <TextBlock Text="{Binding Ip}" FontSize="11" Foreground="#777" Margin="0,2,0,0" />
                                <TextBlock FontSize="11" Foreground="#777">
                                    <Run Text="SN " />
                                    <Run Text="{Binding Sn, TargetNullValue=未上报, Mode=OneWay}" />
                                </TextBlock>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="已跑" FontSize="11" Foreground="#777" />
                                    <TextBlock Grid.Column="1" Text="{Binding EffectiveText}" FontSize="11" FontWeight="SemiBold" Margin="4,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="剩余" FontSize="11" Foreground="#777" />
                                    <TextBlock Grid.Column="3" Text="{Binding RemainingText}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" />
                                </Grid>

                                <TextBlock FontSize="11" Margin="0,2,0,0">
                                    <Run Text="现场 " Foreground="#777" />
                                    <Run Text="{Binding MediaText, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Text="{Binding Note}" FontSize="10" Foreground="#B26A00"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />

                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="开始" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                            Command="{Binding DataContext.StartSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="清理" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                            Command="{Binding DataContext.CleanupMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="复位" FontSize="11" Padding="6,2"
                                            Command="{Binding DataContext.CleanupAllCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 日志 -->
        <GroupBox Grid.Row="3" Header="日志" Margin="0,8,0,0">
            <ListBox ItemsSource="{Binding Logs}" FontSize="11" FontFamily="Consolas"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </GroupBox>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="4" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding SummaryText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="老化不覆盖 HDMI" Foreground="#777" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
